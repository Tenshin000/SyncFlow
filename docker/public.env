# ==============================================================================
# SyncFlow - Environment Configuration (Public Template)
# ==============================================================================

# Application Environment
APP_NAME=SyncFlow
APP_ENV=development
FRONTEND_PORT=8501
STREAMLIT_SERVER_PORT=8501

# MongoDB Server Credentials & Configuration
MONGO_INITDB_ROOT_USERNAME=syncflow_admin
MONGO_INITDB_ROOT_PASSWORD=syncflow_password123
MONGO_INITDB_DATABASE=syncflow_db
MONGO_HOST=mongodb
MONGO_PORT=27017

# PyMongo Connection URI
# Inside Docker Network:
MONGO_URI=mongodb://syncflow_admin:syncflow_password123@mongodb:27017/syncflow_db?authSource=admin
# From Local Host (outside Docker):
# MONGO_URI_HOST=mongodb://syncflow_admin:syncflow_password123@localhost:27017/syncflow_db?authSource=admin

# Mongo Express (Web Database Management GUI) Credentials
ME_CONFIG_MONGODB_ADMINUSERNAME=syncflow_admin
ME_CONFIG_MONGODB_ADMINPASSWORD=syncflow_password123
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin

# LLM Providers Configuration (Enter your API keys below)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_PROVIDER=gemini
